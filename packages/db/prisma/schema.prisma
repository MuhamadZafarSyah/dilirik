// Dilirik — skema data sesuai PRD §9
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Auth (Better Auth) =====
model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  emailVerified          Boolean   @default(false)
  image                  String?
  plan                   String    @default("free")
  // Kuota analisis: null = unlimited; default 10/bulan (PRD §14)
  analysisQuota          Int?      @default(10)
  analysisUsedThisPeriod Int       @default(0)
  quotaResetAt           DateTime?
  // Kuota latihan interview (PRD §7.7): null = unlimited; default 5/bulan
  interviewQuota          Int?      @default(5)
  interviewUsedThisPeriod Int       @default(0)
  interviewQuotaResetAt   DateTime?
  // Kuota surat lamaran (PRD Cover Letter §9.2): null = unlimited; default 3/bulan
  coverLetterQuota          Int?      @default(3)
  coverLetterUsedThisPeriod Int       @default(0)
  coverLetterQuotaResetAt   DateTime?
  // Kuota pencarian lowongan (PRD Cari Lowongan §13.1): null = unlimited; default 15/bulan
  discoveryQuota            Int?      @default(15)
  discoveryUsedThisPeriod   Int       @default(0)
  discoveryQuotaResetAt     DateTime?
  uiLanguage             String?   @default("id")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  cvs               Cv[]
  jobPostings       JobPosting[]
  applications      Application[]
  analysisSessions  AnalysisSession[]
  interviewSessions InterviewSession[]
  coverLetters      CoverLetter[]
  searchProfiles    JobSearchProfile[]
  discoveryRuns     JobDiscoveryRun[]
  jobMatches        JobMatch[]
  pendingQueries    PendingQuery[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String // "credential" | "google" | "github"
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hash utk provider credential
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===== Domain =====
model Cv {
  id             String   @id @default(cuid())
  userId         String
  title          String
  language       String   @default("id")
  rawText        String
  structuredJson Json
  fileKey        String? // key objek R2 bila via upload
  parentCvId     String? // versi lama TIDAK dihapus — untuk compare
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Cv?                @relation("CvVersions", fields: [parentCvId], references: [id], onDelete: SetNull)
  children       Cv[]               @relation("CvVersions")
  applications   Application[]
  analyses       Analysis[]
  coverLetters   CoverLetter[]
  searchProfiles JobSearchProfile[]

  @@index([userId])
  @@map("cv")
}

model JobPosting {
  id         String   @id @default(cuid())
  userId     String
  sourceUrl  String?
  rawText    String
  parsedJson Json
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  coverLetters CoverLetter[]

  @@index([userId])
  @@map("job_posting")
}

enum ApplicationStatus {
  DISIMPAN
  DILAMAR
  SCREENING
  INTERVIEW
  OFFER
  DITOLAK
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  jobPostingId  String
  cvId          String
  coverLetterId String?
  status        ApplicationStatus @default(DISIMPAN)
  matchScore    Int?
  notes         String?
  appliedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  cv          Cv           @relation(fields: [cvId], references: [id], onDelete: Cascade)
  coverLetter CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  analyses    Analysis[]

  @@index([userId, status])
  @@map("application")
}

model Analysis {
  id              String   @id @default(cuid())
  applicationId   String?
  cvId            String
  userId          String
  jobPostingId    String
  cacheKey        String   @unique // hash(cv + job + engineVersion)
  matchScore      Int
  gapsJson        Json
  suggestionsJson Json
  language        String
  engineVersion   String
  createdAt       DateTime @default(now())

  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  cv           Cv            @relation(fields: [cvId], references: [id], onDelete: Cascade)
  coverLetters CoverLetter[]

  @@index([userId])
  @@index([cacheKey])
  @@map("analysis")
}

// Sesi analisis 1-alur (wizard): CV → lowongan → hasil → revisi → selesai.
// Referensi antar-entitas disimpan sebagai id longgar (tanpa FK) supaya draft
// tetap hidup meskipun CV/lowongan-nya dihapus user.
model AnalysisSession {
  id            String   @id @default(cuid())
  userId        String
  status        String   @default("DRAFT") // DRAFT | COMPLETED
  step          String   @default("CV") // CV | JOB | REVIEW | REVISE | FINISH
  cvId          String?
  jobPostingId  String?
  analysisId    String?
  revisedCvId   String?
  applicationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("analysis_session")
}

// Sesi latihan live mock interview (PRD §7.7, M5) — modul TERPISAH dari wizard
// analisis. Referensi cv/job/analysis disimpan sebagai id longgar (tanpa FK),
// konsisten dengan AnalysisSession: riwayat latihan tetap hidup meski sumbernya
// dihapus user. Konteks yang dibutuhkan pewawancara sudah dibekukan ke systemPrompt.
model InterviewSession {
  id             String    @id @default(cuid())
  userId         String
  status         String    @default("CREATED") // CREATED | LIVE | ENDED | FEEDBACK_READY
  persona        String    @default("NETRAL") // SANTAI | NETRAL | TEGAS | MENEKAN
  language       String    @default("id")
  title          String    @default("Latihan Interview")
  cvId           String?
  jobPostingId   String?
  analysisId     String?
  systemPrompt   String // prompt persona hasil compose server-side (tidak pernah dirakit di browser)
  durationSec    Int       @default(0)
  maxDurationSec Int       @default(600) // hard cap biaya per sesi
  transcriptJson Json? // [{ role: interviewer|candidate, text, at }] — disimpan tepat sekali saat sesi berakhir
  feedbackJson   Json? // hasil generateInterviewFeedback (schema Zod di @dilirik/ai)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("interview_session")
}

model CoverLetter {
  id                 String   @id @default(cuid())
  userId             String
  cvId               String
  jobPostingId       String
  analysisId         String?

  text               String
  language           String   @default("id")
  template           String?  @default("professional")
  customInstructions String?

  relevanceScore     Int?
  wordCount          Int

  docxKey            String?
  pdfKey             String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv           Cv           @relation(fields: [cvId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  analysis     Analysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([userId])
  @@index([cvId])
  @@index([jobPostingId])
  @@map("cover_letter")
}

// ===== Cari Lowongan (Job Discovery) — PRD Cari Lowongan §9 =====

// Profil pencarian hasil turunan CV. Dibuat sekali per (user, cv, versi CV) lalu
// dipakai ulang — ini yang membuat pencarian berikutnya tidak perlu memanggil LLM
// untuk hal yang sama. isAutoGenerated=false berarti user sudah mengoreksi profil
// dan hasil LLM TIDAK boleh menimpanya.
model JobSearchProfile {
  id              String   @id @default(cuid())
  userId          String
  cvId            String
  cvVersion       Int      @default(1)
  rolesJson       Json
  skillsJson      Json
  locationsJson   Json
  industriesJson  Json?
  seniority       String? // entry | mid | senior | lead
  remotePref      String   @default("any") // any | remote | hybrid | onsite
  yearsExp        Int?
  salaryMin       Int?
  salaryMax       Int?
  isAutoGenerated Boolean  @default(true)
  promptVersion   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv            Cv                @relation(fields: [cvId], references: [id], onDelete: Cascade)
  discoveryRuns JobDiscoveryRun[]

  @@unique([userId, cvId, cvVersion])
  @@index([userId])
  @@map("job_search_profile")
}

// Indeks lowongan hasil ingestion terjadwal. TIDAK menyimpan salinan penuh
// deskripsi — hanya snippet ≤600 karakter + tautan ke sumber asli. Baris kedaluwarsa
// dibersihkan setiap run (expiresAt), jadi indeks tidak tumbuh tanpa batas.
model DiscoveredJob {
  id                 String    @id @default(cuid())
  fingerprint        String    @unique // sha256(company|title|city|weekOf(postedAt))
  title              String
  titleNorm          String
  company            String
  companyNorm        String
  location           String?
  locationNorm       String?
  city               String?
  remoteType         String? // remote | hybrid | onsite
  descriptionSnippet String    @default("")
  requirementsJson   Json?
  skillTermsJson     Json?
  salaryMin          Int?
  salaryMax          Int?
  currency           String?
  salaryPeriod       String?
  sourcesJson        Json // semua sumber yang melaporkan lowongan ini
  primarySource      String
  applyUrl           String
  sourceUrl          String
  postedAt           DateTime?
  validThrough       DateTime?
  indexedAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  isLikelyStale      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  matches JobMatch[]

  @@index([titleNorm])
  @@index([city])
  @@index([postedAt])
  @@index([expiresAt])
  @@index([companyNorm])
  @@map("discovered_job")
}

// Satu kali user menekan "Cari Lowongan". Menyimpan jejak kualitas (jumlah
// kandidat, filter yang dilonggarkan, sumber yang mati, versi prompt) supaya
// keluhan "hasilnya jelek" bisa ditelusuri, bukan ditebak.
model JobDiscoveryRun {
  id                     String   @id @default(cuid())
  userId                 String
  cvId                   String
  searchProfileId        String?
  status                 String   @default("DONE") // DONE | PARTIAL | EMPTY | FAILED
  candidateCount         Int      @default(0)
  curatedCount           Int      @default(0)
  indexAgeHours          Int?
  relaxedFiltersJson     Json?
  unavailableSourcesJson Json?
  curationNote           String?
  promptVersion          String?
  latencyMs              Int?
  errorMsg               String?
  createdAt              DateTime @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchProfile JobSearchProfile? @relation(fields: [searchProfileId], references: [id], onDelete: SetNull)
  matches       JobMatch[]

  @@index([userId, createdAt])
  @@map("job_discovery_run")
}

// Hasil per lowongan pada satu run. estimatedScore adalah "perkiraan cocok"
// (rule-based, gratis) — SENGAJA dibedakan dari skor analisis penuh yang memakai
// kuota analisis. jobPostingId terisi hanya setelah user meminta analisis penuh.
model JobMatch {
  id                String   @id @default(cuid())
  userId            String
  runId             String
  discoveredJobId   String
  rank              Int
  isTopPick         Boolean  @default(false)
  estimatedScore    Int      @default(0)
  reasonText        String?
  cautionText       String?
  matchedSkillsJson Json?
  missingSkillsJson Json?
  status            String   @default("NEW") // NEW | SAVED | DISMISSED | ANALYZED
  dismissReason     String?
  dismissNote       String?
  jobPostingId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  run           JobDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  discoveredJob DiscoveredJob   @relation(fields: [discoveredJobId], references: [id], onDelete: Cascade)

  @@unique([runId, discoveredJobId])
  @@index([userId, status])
  @@map("job_match")
}

// Daftar kurasi "Direkomendasikan Dilirik". failCount menaikkan diri sendiri saat
// board perusahaan tidak bisa ditarik; pada batas tertentu entri dinonaktifkan
// otomatis supaya slug mati tidak terus membakar waktu ingestion.
model CuratedCompany {
  id            String    @id @default(cuid())
  name          String
  atsProvider   String // greenhouse | lever | ashby | workable | recruitee
  atsSlug       String
  region        String?   @default("ID")
  isActive      Boolean   @default(true)
  failCount     Int       @default(0)
  lastJobCount  Int       @default(0)
  lastFetchedAt DateTime?
  lastErrorMsg  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([atsProvider, atsSlug])
  @@index([isActive])
  @@map("curated_company")
}

// Pencarian yang tidak menemukan apa pun. Ini bukan kegagalan yang dibuang — ini
// daftar permintaan pasar: menentukan perusahaan/kota mana yang layak diindeks
// berikutnya, sekaligus alamat kirim notifikasi bila lowongannya akhirnya muncul.
model PendingQuery {
  id              String   @id @default(cuid())
  queryHash       String   @unique
  userId          String?
  rolesJson       Json
  locationsJson   Json?
  remotePref      String?
  requestCount    Int      @default(1)
  alertRequested  Boolean  @default(false)
  notifiedAt      DateTime?
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([alertRequested])
  @@map("pending_query")
}

// Catatan tiap ingestion run terjadwal — dasar untuk menampilkan umur indeks dan
// sumber yang sedang bermasalah kepada user.
model IngestionRun {
  id                String    @id @default(cuid())
  status            String    @default("RUNNING") // RUNNING | DONE | PARTIAL | FAILED
  trigger           String    @default("cron") // cron | manual
  providerStatsJson Json?
  companiesFetched  Int       @default(0)
  rawCount          Int       @default(0)
  upsertedCount     Int       @default(0)
  newCount          Int       @default(0)
  expiredCount      Int       @default(0)
  errorMsg          String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?

  @@index([startedAt])
  @@map("ingestion_run")
}
