{
  "name": "dilirik",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @dilirik/web e2e",
    "db:push": "pnpm --filter @dilirik/db db:push",
    "db:migrate": "pnpm --filter @dilirik/db db:migrate",
    "db:studio": "pnpm --filter @dilirik/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3"
  }
}
