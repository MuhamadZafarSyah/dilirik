# ===== Database (Neon) =====
DATABASE_URL="postgresql://user:password@host.neon.tech/dilirik?sslmode=require"

# ===== Redis (Upstash REST) =====
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# ===== Better Auth =====
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:4000"

# ===== OAuth =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===== LLM (provider-agnostic, OpenAI-compatible; key milik platform) =====
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY=""
LLM_MODEL="fable-5"

# ===== Gemini Live (Live Mock Interview) =====
# Key hanya dipakai API untuk mencetak ephemeral token — TIDAK pernah dikirim ke browser.
GEMINI_API_KEY=""

# ===== Gotenberg (preview desain DOCX→PDF, iLovePDF-style compare) =====
# Lokal: docker run --rm -p 3001:3000 gotenberg/gotenberg:8
# Production: Cloud Run image gotenberg/gotenberg:8-libreoffice-cloudrun (min 1Gi RAM).
# Kosongkan untuk menonaktifkan fitur preview desain (UI otomatis menyembunyikannya).
GOTENBERG_URL=""
GOTENBERG_BASIC_AUTH_USERNAME=""
GOTENBERG_BASIC_AUTH_PASSWORD=""

# ===== Adobe PDF Services (konversi PDF→DOCX, pertahankan desain asli CV) =====
# Free tier 500 dokumen/bulan: https://developer.adobe.com/document-services/pricing/main/
# Konversi hanya terjadi 1x per upload PDF (hasil di-cache di R2).
# Kosongkan untuk menonaktifkan — upload PDF akan memakai template Dilirik seperti biasa.
PDF_SERVICES_CLIENT_ID=""
PDF_SERVICES_CLIENT_SECRET=""

# ===== Storage (Cloudflare R2, S3-compatible) =====
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dilirik-uploads"

# ===== Email (Resend) =====
RESEND_API_KEY=""
MAIL_FROM="Dilirik <no-reply@dilirik.tech>"

# ===== Observability & Analytics =====
# Semua kunci di bawah OPSIONAL. Bila kosong, analytics mati total dan banner
# consent tidak muncul (tidak ada data dikumpulkan = tidak perlu izin).
SENTRY_DSN=""
# Google Analytics 4 — Measurement ID, format G-XXXXXXXXXX.
# Dimuat dengan Consent Mode v2: semua storage 'denied' sampai pengguna setuju.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-project-token"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ===== Security / CAPTCHA (opsional — kosongkan untuk menonaktifkan) =====
# Pilih SALAH SATU provider. Turnstile (Cloudflare) diprioritaskan bila keduanya di-set.
# Cloudflare Turnstile: https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Google reCAPTCHA v3: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Skor minimum reCAPTCHA v3 (0.0–1.0) agar request dianggap manusia.
CAPTCHA_MIN_SCORE=0.5
# Jumlah hop reverse-proxy di depan API (Cloudflare + load balancer = 1–2).
# Wajib akurat agar rate limiting per-IP membaca IP asli, bukan IP proxy.
TRUST_PROXY_HOPS=1

# ===== Cari Lowongan (job discovery) =====
# SEMUA opsional. Kosong = provider itu mati, bukan boot gagal.
# Halaman karier ATS (Greenhouse/Lever/Ashby/Workable/Recruitee) TIDAK butuh key
# apa pun, jadi fitur tetap jalan tanpa satu pun variabel di bawah terisi — hanya
# cakupan lowongannya lebih sempit.
#
# Adzuna: daftar instan tanpa kartu, ~1.000 call/bulan. https://developer.adzuna.com/signup
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="id"
# Jooble: key developer gratis (per proyek, lewat review). https://jooble.org/api/about
JOOBLE_API_KEY=""
# RapidAPI (JSearch — Google for Jobs). Free tier hanya 200 request/bulan, jadi di
# produksi dipakai sebagai PEMBANDING cakupan saja, bukan sumber utama.
RAPIDAPI_KEY=""
DISCOVERY_JSEARCH_ENABLED="false"
# Secret untuk POST /api/internal/ingest (dipanggil penjadwal, bukan browser).
# KOSONG = endpoint ingestion MATI. Default aman lebih penting daripada praktis.
DISCOVERY_INGEST_SECRET=""
# Batas call harian per provider agar kuota gratis tidak habis dalam sehari.
DISCOVERY_ADZUNA_DAILY_BUDGET=30
DISCOVERY_JOOBLE_DAILY_BUDGET=200
DISCOVERY_JSEARCH_DAILY_BUDGET=0
# Lowongan lebih tua dari ini dibuang dari indeks. Indeks kecil tapi segar lebih
# baik daripada indeks besar berisi lowongan yang sudah tutup.
DISCOVERY_INDEX_RETENTION_DAYS=30

# ===== Web =====
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Selain dipakai Better Auth (trustedOrigins, link verifikasi email), env ini juga
# menjadi SATU-SATUNYA sumber URL kanonik SEO: canonical tag, sitemap.xml,
# robots.txt, dan JSON-LD (lihat apps/web/lib/site.ts).
# Production HARUS apex tanpa www: https://dilirik.tech
# Nilainya di-inline saat build — mengubahnya di dashboard hosting butuh redeploy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== API =====
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development
